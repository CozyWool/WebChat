@model WebChatApplication.Models.StatusMessageModel

<partial name="_StatusMessage" for="@Model"/>

@if (ViewData["ReturnUrl"] is not null)
{
    <a class="btn btn-primary btn-lg w-100 mb-2 mt-2" href="@ViewData["ReturnUrl"]">Вернуться назад</a>
}
<a class="btn btn-secondary btn-lg w-100" asp-controller="Account" asp-action="ChangeProfileInfo">
    Вернуться в профиль
</a>
