@model WebChatApplication.Models.User.LoginModel
@{
	Layout = null;
}
<!doctype html>
<html lang="ru">
<head>
	<meta charset="UTF-8">
	<meta name="viewport"
	      content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
	<meta http-equiv="X-UA-Compatible" content="ie=edge">
	<title>@ViewBag.Title</title>
	<link href="~/css/bootstrap.min.css" rel="stylesheet" type="text/css">
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet"
	      type="text/css"/>
	<link href="~/css/app_style.css" rel="stylesheet" type="text/css">
	<link rel="shortcut icon" type="image/x-icon" href="/images/favicon.ico">
	<link type="image/png" sizes="96x96" rel="icon" href="/images/favicon-96x96.png">
</head>
<body>

<div class="container">
	<main role="main" class="pb-3">
		<div class="bg-grid"></div>
		<div class="login-container">
			<form class="form" asp-action="Login" asp-controller="Account" method="post">
				<input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]"/>
				<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

				<div class="flex-column">
					<label asp-for="UsernameOrEmail">@Html.DisplayNameFor(m => m.UsernameOrEmail)</label>
					<span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
				</div>

				<div class="inputForm">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" viewBox="0 0 32 32" height="20">
						<g data-name="Layer 3" id="Layer_3">
							<path
								d="m30.853 13.87a15 15 0 0 0 -29.729 4.082 15.1 15.1 0 0 0 12.876 12.918 15.6 15.6 0 0 0 2.016.13 14.85 14.85 0 0 0 7.715-2.145 1 1 0 1 0 -1.031-1.711 13.007 13.007 0 1 1 5.458-6.529 2.149 2.149 0 0 1 -4.158-.759v-10.856a1 1 0 0 0 -2 0v1.726a8 8 0 1 0 .2 10.325 4.135 4.135 0 0 0 7.83.274 15.2 15.2 0 0 0 .823-7.455zm-14.853 8.13a6 6 0 1 1 6-6 6.006 6.006 0 0 1 -6 6z"></path>
						</g>
					</svg>
					<input asp-for="UsernameOrEmail" placeholder="Введите эл.почту или имя пользователя" class="input"
					       type="text">
				</div>

				<div class="flex-column">
					<label asp-for="Password">@Html.DisplayNameFor(m => m.Password)</label>
					<span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
				</div>
				<div class="inputForm">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" viewBox="-64 0 512 512" height="20">
						<path
							d="m336 512h-288c-26.453125 0-48-21.523438-48-48v-224c0-26.476562 21.546875-48 48-48h288c26.453125 0 48 21.523438 48 48v224c0 26.476562-21.546875 48-48 48zm-288-288c-8.8125 0-16 7.167969-16 16v224c0 8.832031 7.1875 16 16 16h288c8.8125 0 16-7.167969 16-16v-224c0-8.832031-7.1875-16-16-16zm0 0"></path>
						<path
							d="m304 224c-8.832031 0-16-7.167969-16-16v-80c0-52.929688-43.070312-96-96-96s-96 43.070312-96 96v80c0 8.832031-7.167969 16-16 16s-16-7.167969-16-16v-80c0-70.59375 57.40625-128 128-128s128 57.40625 128 128v80c0 8.832031-7.167969 16-16 16zm0 0"></path>
					</svg>
					<input asp-for="Password" placeholder="Введите пароль" class="input" type="password"
					       id="password-field">
					<i class="fa-solid fa-eye" id="show-password"></i>
				</div>

				<div class="flex-row">
					<div>
						<input asp-for="RememberMe" type="checkbox" class="form-check-input">
						<label asp-for="RememberMe">@Html.DisplayNameFor(m => m.RememberMe)</label>
					</div>
					<span class="span">
						<a type="submit" asp-action="SendPasswordRecoveryEmail" asp-controller="Account"
						   style="text-decoration: none;">
							Забыли пароль?
						</a>
					</span>
				</div>
				<button class="button-submit">Войти</button>
				<p class="p">Не зарегистрированы?
					<span class="span">
						<a style="text-decoration: none;" asp-action="Register"
						   asp-controller="Account">Зарегистрироваться</a></span>
				</p>
				<a class="btn" asp-action="Index" asp-controller="WebChat">На главную</a>
			</form>
		</div>

		<script src="~/js/showPassword.js"></script>
		<script>showPassword("#show-password", "#password-field");</script>
	</main>
</div>
<script src="~/js/bootstrap.min.js"></script>
</body>
</html>

<style>

	body {
		height: 100%;
		overflow-y: hidden;
	}

	.fa-eye {
		margin-right: 10px;
		cursor: pointer;
		color: gray;
	}

	.fa-eye-slash {
		margin-right: 10px;
		cursor: pointer;
		color: gray;
	}

	/* From Uiverse.io by JohnnyCSilva */
	.login-container {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 10px;
		background-color: #ffffff;
		padding: 30px;
		width: 450px;
		height: 500px;
		border-radius: 20px;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
	}

	::placeholder {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
	}

	.form button {
		align-self: flex-end;
	}

	.flex-column > label {
		color: #151717;
		font-weight: 600;
	}

	.inputForm {
		border: 1.5px solid #ecedec;
		border-radius: 10px;
		height: 50px;
		display: flex;
		align-items: center;
		padding-left: 10px;
		transition: 0.2s ease-in-out;
	}

	.input {
		margin-left: 10px;
		border-radius: 10px;
		border: none;
		width: 100%;
		height: 100%;
	}

	.input:focus {
		outline: none;
	}

	.inputForm:focus-within {
		border: 1.5px solid #2d79f3;
	}

	.flex-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 10px;
		justify-content: space-between;
	}

	.flex-row > div > label {
		font-size: 14px;
		color: black;
		font-weight: 400;
	}

	.span {
		font-size: 14px;
		margin-left: 5px;
		color: #2d79f3;
		font-weight: 500;
		cursor: pointer;
	}

	.button-submit {
		margin: 20px 0 10px 0;
		background-color: #151717;
		border: none;
		color: white;
		font-size: 15px;
		font-weight: 500;
		border-radius: 10px;
		height: 50px;
		width: 100%;
		cursor: pointer;
	}

	.p {
		text-align: center;
		color: black;
		font-size: 14px;
		margin: 5px 0;
	}

	.btn {
		margin-top: 10px;
		width: 100%;
		height: 50px;
		border-radius: 10px;
		display: flex;
		justify-content: center;
		align-items: center;
		font-weight: 500;
		gap: 10px;
		border: 2px solid #ededef;
		background-color: white;
		cursor: pointer;
		transition: 0.2s ease-in-out;
	}

	.btn:hover {
		border: 1px solid #2d79f3;;
	}


</style>