@{
    Layout = "Manage/_ManageNav";
}
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using WebChatApplication.Enums
@model WebChatApplication.Models.User.Manage.ChangeEmailModel

<partial name="_StatusMessage" for="StatusMessage"/>
<div class="row">
    <div class="col-md-6">
        <form class="mb-2" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-2">
                <input type="email" class="form-control" asp-for="Email" readonly>
                <label asp-for="Email">@Html.DisplayNameFor(m => m.Email)</label>
            </div>
            <div class="form-floating mb-2">
                <input type="email" autocomplete="email" asp-for="NewEmail" class="form-control"/>
                <label asp-for="NewEmail">@Html.DisplayNameFor(m => m.NewEmail)</label>
                <span asp-validation-for="NewEmail" class="text-danger"></span>
            </div>
            <button asp-action="ChangeEmail" asp-controller="Account" type="submit"
                    class="w-100 btn btn-lg btn-primary">
                Сохранить
            </button>
        </form>
    </div>

    <div class="col-md-6">
        @{
            if (User.Claims.FirstOrDefault(x => x.Type == "UserStatus").Value == UserStatuses.EmailNotConfirmed.ToString())
            {
                <div class="alert alert-warning d-flex align-items-center" role="alert">
                    Внимание! Ваша почта не подтверждена.<br/> Проверьте почту или попробуйте выслать письмо ещё раз.
                </div>
                <form asp-controller="Account" asp-action="ConfirmEmail" method="get">
                    <input name="needToSend" type="text" value="true" hidden/>
                    <input type="email" class="form-control" asp-for="Email" readonly hidden>

                    <button class="btn btn-danger btn-lg w-100" type="submit">Отправить подтверждение на почту</button>
                </form>
            }

            else
            {
                <div class="alert alert-success d-flex align-items-center" role="alert">
                    <i class="fa-solid fa-check me-2"></i>
                    Почта подтверждена
                </div>
            }
        }
    </div>
</div>