@{
    Layout = "Manage/_ManageNav";
}
@model WebChatApplication.Models.User.Manage.ChangePasswordModel

<partial name="_StatusMessage" for="StatusMessage"/>
<div class="row">
    <div class="col-md-6">
        <form asp-action="ChangePassword" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-2">
                <input type="password" class="form-control" autocomplete="password" asp-for="CurrentPassword"
                       id="current-password-field">
                <label asp-for="CurrentPassword">@Html.DisplayNameFor(m => m.CurrentPassword)</label>
                <i class="fa-solid fa-eye" id="show-current-password"></i>
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>
            <div class="form-floating mb-2">
                <input type="password" asp-for="NewPassword" autocomplete="password" class="form-control"
                       id="new-password-field"/>
                <label asp-for="NewPassword">@Html.DisplayNameFor(m => m.NewPassword)</label>
                <i class="fa-solid fa-eye" id="show-new-password"></i>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="form-floating mb-2">
                <input type="password" asp-for="ConfirmPassword" class="form-control" id="confirm-password-field"/>
                <label asp-for="ConfirmPassword">@Html.DisplayNameFor(m => m.ConfirmPassword)</label>
                <i class="fa-solid fa-eye" id="show-confirm-password"></i>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Сохранить</button>
        </form>
    </div>
</div>

<script src="~/js/showPassword.js"></script>
<script>showPassword("#show-current-password", "#current-password-field");</script>
<script>showPassword("#show-new-password", "#new-password-field");</script>
<script>showPassword("#show-confirm-password", "#confirm-password-field");</script>