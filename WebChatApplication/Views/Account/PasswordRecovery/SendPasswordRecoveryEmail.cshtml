@model WebChatApplication.Models.User.PasswordRecovery.SendPasswordRecoveryEmailModel

<partial name="_StatusMessage" for="@Model.StatusMessage"/>
<form asp-controller="Account" asp-action="SendPasswordRecoveryEmail" method="post">
    <div class="form-floating mb-2">
        <input type="email" class="form-control" asp-for="Email">
        <label asp-for="Email">@Html.DisplayNameFor(m => m.Email)</label>
    </div>

    <div class="mb-2">
        <button class="btn btn-primary btn-lg w-100" type="submit">Отправить письмо</button>
    </div>
</form>