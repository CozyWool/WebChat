@model WebChatApplication.Models.User.PasswordRecovery.PasswordRecoveryModel

<partial name="_StatusMessage" for="@Model.StatusMessage"/>

<form asp-controller="Account" asp-action="RecoverPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <input hidden asp-for="PasswordRecoveryToken"/>
    <input hidden asp-for="Email"/>

    <div class="form-floating mb-2">
        <input type="password" asp-for="NewPassword" autocomplete="password" class="form-control"
               id="new-password-field"/>
        <label asp-for="NewPassword">@Html.DisplayNameFor(m => m.NewPassword)</label>
        <i class="fa-solid fa-eye" id="show-new-password"></i>
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>
    <div class="form-floating mb-2">
        <input type="password" asp-for="ConfirmPassword" class="form-control" id="confirm-password-field"/>
        <label asp-for="ConfirmPassword">@Html.DisplayNameFor(m => m.ConfirmPassword)</label>
        <i class="fa-solid fa-eye" id="show-confirm-password"></i>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="w-100 btn btn-lg btn-primary">Подтвердить</button>

</form>

<script src="~/js/showPassword.js"></script>
<script>showPassword("#show-new-password", "#new-password-field");</script>
<script>showPassword("#show-confirm-password", "#confirm-password-field");</script>
