@using WebChatApplication.Models
@model WebChatApplication.Models.WebChatViewModel

<style>
    .side-menu-chat-info {
        display: flex;
        align-items: center;
        padding: 20px;
        margin-bottom: 5px;
        border-radius: 20px;
        height: 70px;
        background-color: #ffffff;
        cursor: pointer;
    }

    .side-menu-chat-info-selected {
        display: flex;
        align-items: center;
        padding: 20px;
        margin-bottom: 5px;
        border-radius: 20px;
        height: 70px;
        background-color: #f5f6f7;
        cursor: pointer;
    }

    .side-menu-chat-info:hover {
        background-color: #f1f1f1;
    }

    .side-menu-last-message {
        margin-bottom: 0;
        color: gray;
        width: 10vw;
    }

    .side-menu-last-message-sent-at {
        margin-left: auto;
        float: right;
        color: gray;
        align-self: center;
        white-space: nowrap;
    }

    .side-menu-container {
        overflow-y: auto;
        margin-right: 10px;
        overflow-x: hidden;
        width: 100%;
        min-width: 20vw;
        max-width: 20vw;
    }


    .current-chat-container {
        width: 100%;
        min-width: 55vw;
    }

    .new-chat-user-card:hover {
        cursor: pointer;
    }
</style>
@if (!User.Identity.IsAuthenticated)
{
    <h3 class="text-center">Добро пожаловать в веб-чат!</h3>
    <h5>Для продолжения войдите в аккаунт или зарегистрируйтесь</h5>
    <div class="d-flex flex-row justify-content-between">
        <a class="btn btn-primary w-100 me-2" asp-area="" asp-controller="Account" asp-action="Login"
           asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">
            Войти
        </a>
        <a class="btn btn-secondary w-100" asp-area="" asp-controller="Account" asp-action="Register"
           asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">
            Зарегистрироваться
        </a>
    </div>
}
else
{
    if (Model.CurrentChat is not null)
    {
        <div id="hide-side-menu-button" class="mb-2" style="cursor:pointer;"><i class="fs-4 fa-solid fa-bars"></i></div>
    }

    <div class="d-flex flex-row" style="min-height: 75vh">
        <div id="side-menu" class="flex-column justify-content-between" style="display: flex">
            <div class="side-menu-container">
                <h5 class="text-center text-truncate">С возвращением,<br/> @User.Identity.Name!</h5>
                <div class="d-flex flex-column">
                    @foreach (var chatModel in Model.Chats)
                    {
                        if (chatModel is PrivateChatModel privateChatModel)
                        {
                            <div
                                class="@(Model.CurrentChat?.Id == privateChatModel.Id ? "side-menu-chat-info-selected" : "side-menu-chat-info")"
                                onclick="location.href = '/web-chat/index?chatId=@chatModel.Id'">
                                <div style="position: relative">
                                    <img src="@privateChatModel.PrivateUser.ProfilePictureUrl" class="chat-profile-img"
                                         alt="...">
                                    <div
                                        style="position: absolute; 
                                        bottom: 0;
                                        right: 0;
                                        margin-right: -5px;
                                        margin-bottom: -10px">
                                        @if (privateChatModel.PrivateUser.IsOnline)
                                        {
                                            <span class="mb-0"><i class="online-status"></i></span>
                                        }
                                        else if (privateChatModel.PrivateUser.LastActivityAt is not null)
                                        {
                                            <span class="mb-0"><i class="offline-status"></i></span>
                                        }
                                        else
                                        {
                                            <span class="mb-0"><i class="never-online-status"></i></span>
                                        }
                                    </div>
                                </div>
                                <div class="ms-3 d-flex flex-column">
                                    <div class="d-flex flex-row">
                                        <span class="text-truncate fw-bold"
                                              style="width: 15vw">@privateChatModel.PrivateUser.Username</span>
                                    </div>
                                    <div class="d-flex flex-row">
                                        <span class="mt-auto text-truncate side-menu-last-message">
                                            @(privateChatModel.Messages.LastOrDefault()?.Content ?? "Нет сообщений")
                                        </span>
                                        <span class="date-utc-span side-menu-last-message-sent-at">
                                            @(privateChatModel.Messages.LastOrDefault()?.SentAt.ToString() ?? "")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (chatModel is GroupChatModel groupChatModel)
                        {
                            <div
                                class="@(Model.CurrentChat?.Id == groupChatModel.Id ? "side-menu-chat-info-selected" : "side-menu-chat-info")"
                                onclick="location.href = '/web-chat/index?chatId=@chatModel.Id'">
                                <div>
                                    <img src="@groupChatModel.ChatPictureUrl" class="chat-profile-img"
                                         alt="...">
                                </div>
                                <div class="ms-3 d-flex flex-column">
                                    <div class="d-flex flex-row">
                                        <span class="text-truncate fw-bold"
                                              style="width: 15vw">@groupChatModel.Name</span>
                                    </div>
                                    <div class="d-flex flex-row">
                                        <span class="mt-auto text-truncate side-menu-last-message">
                                            @(groupChatModel.Messages.LastOrDefault()?.Content ?? "Нет сообщений")
                                        </span>
                                        <span class="date-utc-span side-menu-last-message-sent-at">
                                            @(groupChatModel.Messages.LastOrDefault()?.SentAt.ToString() ?? "")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="WebChat" asp-action="Index" asp-route-chatId="@chatModel.Id">
                                @chatModel.Name - @chatModel.ChatType - @chatModel.Id
                            </a>
                        }
                    }
                </div>
            </div>
            <div class="dropdown open">
                <div
                    style="cursor:pointer;"
                    id="triggerId"
                    data-bs-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false">
                    <i class="fs-5 fa-solid fa-plus"></i>
                </div>
                <div class="dropdown-menu" aria-labelledby="triggerId">
                    <button class="dropdown-item p-3" data-bs-toggle="modal" data-bs-target="#newPrivateChatModal">
                        <i class="fa-solid fa-user me-2" style="width: 20px"></i> Создать приватный чат
                    </button>
                    <button class="dropdown-item p-3" data-bs-toggle="modal" data-bs-target="#newGroupChatModal">
                        <i class="fa-solid fa-user-group me-2" style="width: 20px"></i> Создать групповой чат
                    </button>
                </div>
            </div>
        </div>

        <div class="current-chat-container">
            @if (Model.CurrentChat is PrivateChatModel currentPrivateChat)
            {
                <partial name="PrivateChat" for="@currentPrivateChat"/>
            }
            else if (Model.CurrentChat is GroupChatModel currentGroupChat)
            {
                <partial name="GroupChat" for="@currentGroupChat"/>
            }
            else
            {
                <h3 class="text-center">Выберите чат</h3>
            }
        </div>
    </div>

    <!-- Private chat Modal -->
    <div class="modal fade" id="newPrivateChatModal" tabindex="-1" aria-labelledby="newPrivateChatModalLabel"
         data-bs-backdrop="static"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="newPrivateChatModalLabel">Создать приватный чат</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="newPrivateChatDiv">
                    <ul>
                        @foreach (var friend in Model.Friends)
                        {
                            <partial name="NewChatUserCard" for="@friend"/>
                        }
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Group chat Modal -->
    <form id="newGroupChatForm" method="post" enctype="multipart/form-data" asp-action="GroupChat"
          asp-controller="WebChat">
        <div class="modal fade" id="newGroupChatModal" tabindex="-1" aria-labelledby="newGroupChatModalLabel"
             data-bs-backdrop="static"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="newGroupChatModalLabel">Создать групповой чат</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="d-flex flex-row">
                            <div class="form-control d-flex flex-column w-auto">
                                <label for="newGroupChatPicture">Фото группы</label>
                                <label class="avatar-wrapper">
                                    <img id="newGroupChatPicturePreview"
                                         src="~/images/no_photo.png"
                                         alt="Фото группы"
                                         class="avatar cursor-pointer">
                                    <div class="avatar-overlay"><i class="fa-solid fa-pen"></i></div>
                                    <input type="file" accept="image/*" class="d-none" id="newGroupChatPicture"
                                           name="chatPicture">
                                </label>
                            </div>
                            <div class="form-floating mt-auto mb-auto w-100">
                                <input type="text" class="form-control" name="chatName" required>
                                <label for="chatName">Название группы</label>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="button" class="btn btn-primary" data-bs-target="#selectGroupMembersModal"
                                data-bs-toggle="modal">Далее
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="selectGroupMembersModal" tabindex="-1"
             aria-labelledby="selectGroupMembersModalLabel"
             data-bs-backdrop="static"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="selectGroupMembersModalLabel">Выберите участников</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <ul>
                            @foreach (var friend in Model.Friends)
                            {
                                <div class="form-check d-flex flex-row">
                                    <input class="form-check-input mt-auto mb-auto me-2" type="checkbox"
                                           value="@friend.UserId" name="groupMemberId">
                                    <partial name="NewChatUserCard" for="@friend"/>
                                </div>
                            }
                        </ul>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary"
                                data-bs-target="#newGroupChatModal"
                                data-bs-toggle="modal">Назад
                        </button>
                        <button type="submit" class="btn btn-primary">Создать</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
}

@section Scripts
{
    @if (Model.CurrentChat is PrivateChatModel currentPrivateChat)
    {
        <partial name="_PrivateChatScripts" for="@currentPrivateChat"></partial>
    }
    else if (Model.CurrentChat is GroupChatModel currentGroupChat)
    {
        <partial name="_GroupChatScripts" for="@currentGroupChat"></partial>
    }
    <script>
        let hideSideMenuButton = $("#hide-side-menu-button");
        let sideMenu = $("#side-menu");
        let isSideMenuHidden = false;
        hideSideMenuButton.click(function () {
            if (isSideMenuHidden) {
                sideMenu.show();
            } else {
                sideMenu.hide();
            }
            isSideMenuHidden = !isSideMenuHidden;
        })
    </script>

    <script>
        let newGroupChatPicture = document.querySelector("#newGroupChatPicture");
        let newGroupChatPicturePreview = document.querySelector("#newGroupChatPicturePreview");
        newGroupChatPicture.addEventListener("change", function () {
            let reader = new FileReader();
            reader.onload = function (e) {
                newGroupChatPicturePreview.src = e.target.result;
            };
            reader.readAsDataURL(this.files[0]);
        });

        let newGroupChatForm = document.querySelector("#newGroupChatForm");
        newGroupChatForm.addEventListener("submit", async function (event) {
            event.preventDefault();
            const formData = new FormData(newGroupChatForm);
            let userIds = [];
            newGroupChatForm.querySelectorAll('input[name=groupMemberId]:checked').forEach(element => {
                userIds.push(element.value)
            })

            formData.append('userIdsJson', JSON.stringify(userIds))
            try {
                const response = await fetch(`/web-chat/group-chat`, {
                    method: 'POST',
                    body: formData
                });
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                console.log("Success:", response);
                window.location.href = response.url;
            } catch (error) {
                console.error('Error:', error);
            }
        });
    </script>
    <script>
        newPrivateChatDiv = document.querySelector("#newPrivateChatDiv");
        document.querySelectorAll('.new-chat-user-card').forEach(el => {
            if (newGroupChatForm.contains(el)) {
                el = $(el)
                el.click(async function () {
                    let userId = el.attr("data-user-id");
                    let checkBox = newGroupChatForm.querySelector(`input[name=groupMemberId][value="${userId}"]`);
                    checkBox.checked = !checkBox.checked;
                });
            } else if (newPrivateChatDiv.contains(el)) {
                el = $(el)
                el.click(async function () {
                    let userId = el.attr("data-user-id");
                    try {
                        const response = await fetch(`/web-chat/private-chat/${userId}`, {
                            method: 'POST',
                        });

                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        console.log("Success:", response);
                        window.location.href = response.url;
                    } catch (error) {
                        console.error('Error:', error);
                    }
                });
            }
        });
    </script>

}