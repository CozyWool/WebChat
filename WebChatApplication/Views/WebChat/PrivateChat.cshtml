@model WebChatApplication.Models.PrivateChatModel

<link href="~/css/chat-style.css" rel="stylesheet"/>

<div class="message-wrap">
    <div class="receiver-info">
        <div>
            <a href="@Url.Action(
                                 "ProfileInfo",
                                 "Account",
                                 new {username = Model.PrivateUser.Username},
                                 Context.Request.Scheme)">
                <img src="@Model.PrivateUser.ProfilePictureUrl" class="profile-img" alt="..."></a>
        </div>
        <h4 class="ms-4 mt-auto mb-auto">@Model.PrivateUser.Username</h4>
        <div class="ms-auto">
            @if (Model.PrivateUser.IsOnline)
            {
                <span class="mb-0"><i class="online-status"></i> Онлайн</span>
            }
            else if (Model.PrivateUser.LastActivityAt is not null)
            {
                <span class="mb-0">
                    <i class="offline-status"></i> Был(а) в сети:
                    <date-humanizer utc-date-time="@Model.PrivateUser.LastActivityAt"/>
                </span>
            }
            else
            {
                <span class="mb-0"><i class="never-online-status"></i> Не был(а) в сети</span>
            }
        </div>
    </div>

    <div class="messages-box">
        <span class="load-more-messages btn btn-dark">Загрузить больше сообщений</span>
        @foreach (var message in Model.Messages)
        {
            <div class="message @(message.IsCurrentUserSentMessage ? "sent-message" : "received-message")"
                 id="@message.Id">
                <div class="profile-img-container">
                    <a href="@Url.Action(
                                         "ProfileInfo",
                                         "Account",
                                         new {username = message.Author.Username},
                                         Context.Request.Scheme)">
                        <img src="@message.Author.ProfilePictureUrl" class="profile-img" alt="..."></a>
                </div>
                <div class="message-container">
                    <div>
                        <a href="@Url.Action(
                                             "ProfileInfo",
                                             "Account",
                                             new {username = message.Author.Username},
                                             Context.Request.Scheme)"
                           class="message-username">@message.Author.Username</a>
                        <span class="reply-span" data-message-id="@message.Id">Ответить</span>
                    </div>
                    @if (message.ParentMessage is not null)
                    {
                        <div class="reply quote-like quote-like-hoverable quote-like-border"
                             data-parent-message-id="@message.ParentMessage.Id">
                            <div class="c-ripple"></div>
                            <div class="reply-content">
                                <div class="reply-title">
                                    <span>@message.ParentMessage.Author.Username</span>
                                </div>
                                <div class="reply-subtitle">@message.ParentMessage.Content</div>
                            </div>
                        </div>
                    }
                    <div>
                        <span class="message-content">@message.Content</span>
                        <span class="date-utc-span sent-at-span">@message.SentAt.ToString()</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="send-message-box">
        <div class="reply quote-like quote-like-hoverable quote-like-border mb-2" id="send-message-reply-container">
            <div class="c-ripple"></div>
            <div class="reply-content" style="display: flex">
                <div style="width: 95%;">
                    <div class="reply-title">
                        <span id="send-message-reply-title">В ответ </span>
                    </div>
                    <div class="reply-subtitle">
                        <span id="send-message-reply-subtitle">Контент тут</span>
                    </div>
                </div>
                <i id="send-message-close-reply-button" style="z-index: 2"
                   class="fa-solid fa-xmark float-end ms-auto me-3 mt-auto mb-auto"></i>
            </div>
        </div>

        <textarea rows="4" class="message-field" placeholder="Сообщение..."></textarea>
        <button class="send-btn btn btn-dark">Отправить</button>
    </div>
</div>

<style>
    .c-ripple {
        position: absolute;
        inset: 0;
    }

    .reply-content {
        padding: 3px 0;
        padding-inline-end: .375rem;
        margin-inline-start: .5rem;
        display: block
    }

    .reply-title {
        color: rgb(92, 168, 83);
    }

    .reply-subtitle {
        font-size: 14px;
        position: relative;
        white-space: nowrap;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .quote-like {
        background-color: rgba(64, 169, 32, .1);
        overflow: hidden;
        border-radius: .25rem;
        position: relative
    }

    .quote-like-hoverable {
        cursor: pointer;
    }

    .quote-like-border:before {
        content: " ";
        position: absolute;
        inset-inline-start: 0;
        top: 0;
        bottom: 0;
        flex: 0 0 auto;
        width: .1875rem;
        background: rgb(92, 168, 83);
        z-index: 1;
    }
</style>

<div>
    <div class="context-menu">
        <div class="context-menu-list">
            <div class="context-menu-section">
                <div class="context-menu-item" id="context-menu-reply-button">
                    <div class="context-menu-name">
                        <i class="fa-solid fa-reply me-2"></i> Ответить
                    </div>
                </div>
                <div class="context-menu-item" id="context-menu-forward-button">
                    <div class="context-menu-name">
                        <i class="fa-solid fa-share me-2"></i> Переслать
                    </div>
                </div>
                <div class="context-menu-item" id="context-menu-delete-button">
                    <div class="context-menu-name">
                        <i class="fa-solid fa-trash me-2"></i> Удалить
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        let contextMenu = document.querySelector(".context-menu");
        let contextMenuReplyButton = document.querySelector("#context-menu-reply-button");
        let contextMenuForwardButton = document.querySelector("#context-menu-forward-button");
        let contextMenuDeleteButton = document.querySelector("#context-menu-delete-button");
        let selectedMessage = null;

        let sendMessageReplyContainer = document.querySelector("#send-message-reply-container");
        let sendMessageReplyTitle = document.querySelector("#send-message-reply-title");
        let sendMessageReplySubtitle = document.querySelector("#send-message-reply-subtitle");
        sendMessageReplyContainer.style.display = "none";

        let intiHeight = contextMenu.offsetHeight;
        let initWidth = contextMenu.offsetWidth;
        contextMenu.style.display = "none";
        document.querySelectorAll('.message').forEach(element => {
            element.addEventListener("contextmenu", contextMenuEventHandler);
        });
        document.querySelectorAll('.reply-span').forEach(replySpanEventHandler);

        contextMenuReplyButton.addEventListener("click", replyClick)
        contextMenuForwardButton.addEventListener("click", forwardClick)
        contextMenuDeleteButton.addEventListener("click", deleteClick)


        window.addEventListener("click", () => {
            contextMenu.style.display = "none";
        });
        $("#send-message-close-reply-button").click(closeReplyBox);

        function replySpanEventHandler(el) {
            const messageId = el.dataset.messageId;
            if (messageId) {
                el.addEventListener("click", () => {
                    let parentElement = el.parentElement.parentElement;
                    selectedMessage = {
                        id: messageId,
                        authorUsername: parentElement.querySelector(".message-username").textContent,
                        content: parentElement.querySelector(".message-content").textContent
                    }
                    replyClick()
                });
            }
        }

        function closeReplyBox() {
            sendMessageReplyContainer.style.display = "none";
            selectedMessage = null;
        }

        function contextMenuEventHandler(e) {
            e.preventDefault();
            const clickedElement = $(e.currentTarget)
            const parentElement = clickedElement.parent(".message");
            const messageId = parentElement.prevObject.attr("id");
            console.log("messageId: ", messageId)
            selectedMessage = {
                id: messageId,
                authorUsername: parentElement.prevObject.find(".message-username")[0].textContent,
                content: parentElement.prevObject.find(".message-content")[0].textContent
            }

            openMenu(e);
        }

        function openMenu(e) {
            let positionX = e.clientX;
            let positionY = e.clientY;
            let wHeight = window.innerHeight;
            let wWidth = window.innerWidth;

            let menuHeight = contextMenu.offsetHeight || intiHeight;
            let menuWidth = contextMenu.offsetWidth || initWidth;

            let availableHeight = wHeight - positionY;
            let availableWidth = wWidth - positionX;

            if (availableHeight >= menuHeight) {
                contextMenu.style.top = positionY + "px";
                contextMenu.style.bottom = "auto";
            } else {
                contextMenu.style.bottom = wHeight - positionY + "px";
                contextMenu.style.top = "auto";
                if (positionY < menuHeight) {
                    contextMenu.style.top = "0px";
                    contextMenu.style.bottom = "auto";
                }
            }

            if (availableWidth >= menuWidth) {
                contextMenu.style.left = positionX + "px";
                contextMenu.style.right = "auto";
            } else {
                contextMenu.style.right = wWidth - positionX + "px";
                contextMenu.style.left = "auto";
            }
            contextMenu.style.display = "block";
        }

        function replyClick() {
            console.log("Reply button with id: ", selectedMessage.id);
            sendMessageReplyTitle.innerHTML = `В ответ ${selectedMessage.authorUsername}`;
            sendMessageReplySubtitle.innerHTML = selectedMessage.content;
            sendMessageReplyContainer.style.display = "block";
        }

        function forwardClick() {
            console.log("Forward button with id: ", selectedMessage.id);
        }

        async function deleteClick() {
            try {
                let confirmedDelete = confirm("Вы уверены, что хотите удалить это сообщение?")
                if (!confirmedDelete) return
                const response = await fetch(`/web-chat/delete-message/` + selectedMessage.id, {
                    method: "DELETE",
                    headers: {"Accept": "application/json", "Content-Type": "application/json"}
                });
                console.log(response);
                if (response.ok) {
                    deleteMessage(selectedMessage.id);
                    connection.invoke("DeleteMessage", chatId, selectedMessage.id);
                } else {
                    alert('Произошла ошибка при удалении/Нет доступа');
                }
            } catch (error) {
                console.log(error);
                alert('Произошла ошибка при удалении/Нет доступа');
            }
            console.log("Delete button with id: ", selectedMessage.id);
        }

        function deleteMessage(messageId) {
            const element = document.getElementById(messageId);
            element.parentNode.removeChild(element);
        }
    </script>

    <script src="~/js/signalr.min.js"></script>

    <script>
        const chatId = "@Model.Id";
        const currentUserId = "@Model.CurrentUser.UserId";
        const currentUsername = "@Model.CurrentUser.Username";
        const currentUserProfilePictureUrl = "@Model.CurrentUser.ProfilePictureUrl";

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();
        const messagesBox = $(".messages-box");
        const messageField = $(".message-field");

        connection.start().then(function () {
            connection.invoke("JoinChat", chatId)
            console.log("Connected!");
        }).catch(function (err) {
            console.error(err)
            console.error(err.toString())
        });

        function sendMessage() {
            try {
                const content = messageField.val();
                const messageId = generateRandomGuid();

                if (content === "") {
                    return;
                }

                const message = {
                    Id: messageId,
                    SentAt: "@DateTime.UtcNow",
                    Content: content,
                    Author: {
                        Id: currentUserId,
                        Username: currentUsername,
                        ProfilePictureUrl: currentUserProfilePictureUrl
                    },
                    ParentMessage: null
                }

                if (selectedMessage !== null) {
                    message.ParentMessage = {
                        Id: selectedMessage.id,
                        Author: {
                            Username: selectedMessage.authorUsername
                        },
                        Content: selectedMessage.content
                    };
                }
                closeReplyBox();
                connection.invoke("SendMessage", chatId, JSON.stringify(message));
                receiveMessage(message);
                messageField.val("").focus();
            } catch (error) {
                console.error(error);
            }
        }

        $(".send-btn").click(sendMessage);
        messageField.keypress(function (e) {
            if (e.which === 13 && !e.shiftKey) {
                e.preventDefault();

                sendMessage();
            }
        });

        connection.on("ReceiveMessage", receiveMessage);
        connection.on("DeleteMessage", deleteMessage);

        function receiveMessage(message) {
            try {
                if (typeof message === "string") {
                    message = JSON.parse(message);
                }
                console.log("Received message", message);
                let _messageElement = renderMessageElement(message);

                messagesBox.append(_messageElement);
                messagesBox[0].lastElementChild.addEventListener("contextmenu", contextMenuEventHandler);
                messagesBox[0].lastElementChild.querySelectorAll('.reply-span').forEach(replySpanEventHandler);

                if (message.Author.Id == currentUserId) {
                    messagesBox.scrollTop(messagesBox[0].scrollHeight);
                }
            } catch (error) {
                console.error(error);
            }
        }


        $(goToLastMessage)

        function goToLastMessage() {
            messagesBox.scrollTop(messagesBox[0].scrollHeight);
        }

        function generateRandomGuid() {
            return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
                return v.toString(16);
            });
        }

        function renderMessageElement(message) {
            let content = $('<div />').text(message.Content).html();
            let authorProfileInfoUrl = `/account/profile-info?username=${message.Author.Username}`;
            let parentMessageElement = ``;
            if (message.ParentMessage !== null) {
                parentMessageElement = `<div class="reply quote-like quote-like-hoverable quote-like-border"
                                             data-parent-message-id="${message.ParentMessage.Id}">
                                            <div class="c-ripple"></div>
                                            <div class="reply-content">
                                                <div class="reply-title">
                                                    <span>${message.ParentMessage.Author.Username}</span>
                                                </div>
                                                <div class="reply-subtitle">${message.ParentMessage.Content}</div>
                                            </div>
                                        </div>`
            }
            let messageClass;
            if (message.Author.Id == currentUserId) {
                messageClass = `sent-message`;
            } else {
                messageClass = `received-message`;
            }
            const messageElement = `<div class="message ${messageClass}" id="${message.id}">
                            <div class="profile-img-container">
                                <a href="${authorProfileInfoUrl}">
                                    <img src="${message.Author.ProfilePictureUrl}" class="profile-img" alt="...">
                                </a>
                            </div>
                        
                            <div class="message-container">
                                <div>
                                    <a href="${message.Author.ProfilePictureUrl}" class="message-username">
                                        ${message.Author.Username}
                                    </a>
                                    <span class="reply-span" data-message-id="${message.Id}">Ответить</span>
                                </div>
                                ${parentMessageElement}
                                <div>
                                    <span class="message-content">${content}</span>
                                    <span class="sent-at-span">${formatDateTime(toLocalTime(message.SentAt))}</span>
                                </div>
                            </div>
                        </div>`
            return messageElement;
        }

        $(".load-more-messages").click(() => {
            // TODO
        });

    </script>
}

