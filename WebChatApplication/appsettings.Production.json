{
  "EmailConfiguration": {
    "From": "{{email-account-username}}",
    "SmtpServer": "{{email-smtp-server}}",
    "Port": "{{email-smtp-port}",
    "Username": "{{email-account-username}}",
    "Password": "{{email-account-password}}"
  },
  "MinioConfiguration": {
    "Endpoint": "{{minio-endpoint}}",
    "AccessKey": "{{minio-access-key}}",
    "SecretKey": "{{minio-secret-key}}",
    "BucketId": "{{minio-bucket-id}}"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host={{database-host}};Port={{database-port};Username={{database-username}};Password={{database-password}};Database={{database-name}};"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
